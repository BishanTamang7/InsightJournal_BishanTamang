@page "/calendar"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject NavigationManager Navigation
@inject ILogger<Calendar> Logger

<PageTitle>Calendar</PageTitle>

<div class="calendar-page">
    <div class="calendar-header">
        <h1 class="calendar-title">Calendar View</h1>
    </div>

    @if (hasError)
    {
        <div class="alert alert-error">
            <p>⚠️ @errorMessage</p>
            <button class="btn btn-secondary" @onclick="RetryLoad">Retry</button>
        </div>
    }

    <div class="calendar-container">
        <!-- Month Navigation -->
        <div class="calendar-nav">
            <button class="nav-btn" @onclick="PreviousMonth" disabled="@isLoading">
                <span>← Previous</span>
            </button>
            <h2 class="current-month">@currentDate.ToString("MMMM yyyy")</h2>
            <button class="nav-btn" @onclick="NextMonth" disabled="@isLoading">
                <span>Next →</span>
            </button>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">
                <p>Loading calendar...</p>
            </div>
        }
        else
        {
            <!-- Calendar Grid -->
            <div class="calendar-grid">
                <!-- Weekday Headers -->
                <div class="weekday-header">Sun</div>
                <div class="weekday-header">Mon</div>
                <div class="weekday-header">Tue</div>
                <div class="weekday-header">Wed</div>
                <div class="weekday-header">Thu</div>
                <div class="weekday-header">Fri</div>
                <div class="weekday-header">Sat</div>

                <!-- Calendar Days -->
                @foreach (var day in calendarDays)
                {
                    <div class="calendar-day @GetDayClasses(day)" @onclick="() => SelectDate(day)">
                        <span class="day-number">@day.Day</span>
                        @if (HasEntry(day))
                        {
                            <div class="entry-indicator"></div>
                        }
                    </div>
                }
            </div>

            <!-- Selected Date Entry -->
            @if (selectedEntry != null)
            {
                <div class="entry-preview">
                    <div class="entry-preview-header">
                        <h3>@selectedEntry.Title</h3>
                        <span class="entry-date">@selectedEntry.Date.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="entry-preview-content">
                        @(selectedEntry.Content.Length > 200 ? selectedEntry.Content.Substring(0, 200) + "..." : selectedEntry.Content)
                    </div>
                    <div class="entry-preview-actions">
                        <button class="btn-view-full" @onclick="() => ViewEntry(selectedEntry)">
                            View Full Entry
                        </button>
                    </div>
                </div>
            }
            else if (selectedDate.HasValue && !HasEntry(selectedDate.Value))
            {
                <div class="entry-preview no-entry">
                    <p>No entry for @selectedDate.Value.ToString("MMMM dd, yyyy")</p>
                    <button class="btn-create-entry" @onclick="CreateEntryForDate">
                        Create Entry
                    </button>
                </div>
            }
        }
    </div>
</div>

<style>
    .calendar-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px 24px;
        background-color: var(--bg-primary);
        min-height: 100vh;
    }

    .calendar-header {
        margin-bottom: 30px;
    }

    .calendar-title {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .calendar-container {
        background-color: var(--bg-secondary);
        border-radius: 12px;
        padding: 30px;
        border: 1px solid var(--border-color);
    }

    .calendar-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .nav-btn {
        padding: 10px 20px;
        background-color: #5b5fc7;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .nav-btn:hover:not(:disabled) {
            background-color: #4a4fb0;
            transform: translateY(-1px);
        }

        .nav-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .current-month {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
        margin-bottom: 30px;
    }

    .weekday-header {
        text-align: center;
        font-weight: 600;
        color: var(--text-secondary);
        padding: 12px 0;
        font-size: 14px;
    }

    .calendar-day {
        aspect-ratio: 1;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 8px;
        cursor: pointer;
        transition: all 0.2s;
        background-color: var(--bg-primary);
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .calendar-day:hover {
            border-color: var(--border-active);
            transform: translateY(-2px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .calendar-day.other-month {
            opacity: 0.3;
            pointer-events: none;
        }

        .calendar-day.today {
            border-color: #5b5fc7;
            border-width: 2px;
            background-color: rgba(91, 95, 199, 0.05);
        }

        .calendar-day.selected {
            background-color: #5b5fc7;
            border-color: #5b5fc7;
        }

            .calendar-day.selected .day-number {
                color: white;
            }

        .calendar-day.has-entry {
            background-color: rgba(16, 185, 129, 0.1);
            border-color: #10b981;
        }

    .day-number {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .entry-indicator {
        width: 6px;
        height: 6px;
        background-color: #10b981;
        border-radius: 50%;
        margin-top: 4px;
    }

    .loading-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--text-secondary);
    }

    .entry-preview {
        background-color: var(--bg-primary);
        border-radius: 12px;
        padding: 24px;
        border: 1px solid var(--border-color);
    }

        .entry-preview.no-entry {
            text-align: center;
            padding: 40px;
        }

            .entry-preview.no-entry p {
                color: var(--text-secondary);
                margin-bottom: 20px;
            }

    .entry-preview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

        .entry-preview-header h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
            color: var(--text-primary);
        }

    .entry-date {
        color: var(--text-secondary);
        font-size: 14px;
    }

    .entry-preview-content {
        color: var(--text-primary);
        line-height: 1.6;
        margin-bottom: 20px;
        white-space: pre-wrap;
    }

    .entry-preview-actions {
        display: flex;
        gap: 12px;
    }

    .btn-view-full, .btn-create-entry {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-view-full {
        background-color: #5b5fc7;
        color: white;
    }

        .btn-view-full:hover {
            background-color: #4a4fb0;
        }

    .btn-create-entry {
        background-color: #5b5fc7;
        color: white;
    }

        .btn-create-entry:hover {
            background-color: #4a4fb0;
        }

    .alert {
        padding: 16px;
        background-color: #fee;
        border-left: 4px solid #e53e3e;
        color: #c53030;
        border-radius: 8px;
        margin: 20px 0;
    }

        .alert button {
            margin-top: 10px;
        }

    @@media (max-width: 768px) {
        .calendar-container {
            padding: 16px;
        }

        .calendar-nav {
            flex-direction: column;
            gap: 16px;
        }

        .nav-btn {
            width: 100%;
        }

        .calendar-grid {
            gap: 4px;
        }

        .day-number {
            font-size: 14px;
        }

        .entry-preview-actions {
            flex-direction: column;
        }
    }
</style>

@code {
    private DateTime currentDate = DateTime.Today;
    private DateTime? selectedDate;
    private List<DateTime> calendarDays = new();
    private List<JournalEntry> entries = new();
    private JournalEntry? selectedEntry;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
        GenerateCalendarDays();
    }

    private async Task LoadEntries()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            entries = await JournalService.GetAllEntriesAsync();
            Logger.LogInformation("Successfully loaded {Count} entries for calendar", entries.Count);
        }
        catch (ApplicationException ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load entries for calendar");
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "An unexpected error occurred while loading the calendar.";
            Logger.LogError(ex, "Unexpected error loading calendar entries");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RetryLoad()
    {
        await LoadEntries();
        GenerateCalendarDays();
    }

    private void GenerateCalendarDays()
    {
        try
        {
            calendarDays.Clear();

            var firstDayOfMonth = new DateTime(currentDate.Year, currentDate.Month, 1);
            var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);

            // Get the starting Sunday
            var startDate = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);

            // Get the ending Saturday
            var endDate = lastDayOfMonth.AddDays(6 - (int)lastDayOfMonth.DayOfWeek);

            // Generate all days
            for (var date = startDate; date <= endDate; date = date.AddDays(1))
            {
                calendarDays.Add(date);
            }

            Logger.LogDebug("Generated {Count} calendar days for {Month} {Year}",
                calendarDays.Count, currentDate.Month, currentDate.Year);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating calendar days");
            calendarDays.Clear(); // Ensure we don't display partial data
        }
    }

    private void PreviousMonth()
    {
        currentDate = currentDate.AddMonths(-1);
        GenerateCalendarDays();
        selectedDate = null;
        selectedEntry = null;
        Logger.LogInformation("Navigated to previous month: {Date}", currentDate);
    }

    private void NextMonth()
    {
        currentDate = currentDate.AddMonths(1);
        GenerateCalendarDays();
        selectedDate = null;
        selectedEntry = null;
        Logger.LogInformation("Navigated to next month: {Date}", currentDate);
    }

    private void SelectDate(DateTime date)
    {
        selectedDate = date;
        selectedEntry = entries.FirstOrDefault(e => e.Date.Date == date.Date);
        Logger.LogDebug("Selected date: {Date}, HasEntry: {HasEntry}", date, selectedEntry != null);
    }

    private bool HasEntry(DateTime date)
    {
        return entries.Any(e => e.Date.Date == date.Date);
    }

    private string GetDayClasses(DateTime date)
    {
        var classes = new List<string>();

        if (date.Month != currentDate.Month)
        {
            classes.Add("other-month");
        }

        if (date.Date == DateTime.Today)
        {
            classes.Add("today");
        }

        if (selectedDate.HasValue && date.Date == selectedDate.Value.Date)
        {
            classes.Add("selected");
        }

        if (HasEntry(date))
        {
            classes.Add("has-entry");
        }

        return string.Join(" ", classes);
    }

    private void ViewEntry(JournalEntry entry)
    {
        Navigation.NavigateTo($"/viewentry/{entry.Id}");
    }

    private void CreateEntryForDate()
    {
        // Navigate to new entry page
        Navigation.NavigateTo("/newentry");
    }
}