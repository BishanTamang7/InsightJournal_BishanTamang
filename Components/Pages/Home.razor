@page "/"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

<PageTitle>Dashboard - InsightJournal</PageTitle>

<div class="dashboard-page">
    <!-- Simple Header -->
    <div class="dashboard-header">
        <h1>@GetGreeting() 👋</h1>
        <p class="date">@DateTime.Today.ToString("MMMM dd, yyyy")</p>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <p>Loading...</p>
        </div>
    }
    else if (hasError)
    {
        <div class="error-box">
            <p>⚠️ @errorMessage</p>
            <button class="btn-retry" @onclick="LoadDashboard">Retry</button>
        </div>
    }
    else
    {
        <!-- Today Status -->
        @if (todayEntry != null)
        {
            <div class="status-banner success">
                <span class="icon">✅</span>
                <span>You've journaled today!</span>
            </div>
        }
        else
        {
            <div class="status-banner pending">
                <span class="icon">📝</span>
                <span>You haven't written today</span>
                <button class="btn-inline" @onclick="CreateNewEntry">Write Now</button>
            </div>
        }

        <!-- Quick Stats Grid -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-value">@currentStreak</div>
                <div class="stat-label">Current Streak</div>
            </div>

            <div class="stat-box">
                <div class="stat-value">@longestStreak</div>
                <div class="stat-label">Longest Streak</div>
            </div>

            <div class="stat-box">
                <div class="stat-value">@totalEntries</div>
                <div class="stat-label">Total Entries</div>
            </div>

            <div class="stat-box">
                <div class="stat-value">@missedDays</div>
                <div class="stat-label">Missed Days</div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="actions-row">
            <button class="action-btn primary" @onclick="CreateNewEntry">
                <span class="btn-icon">➕</span>
                New Entry
            </button>
            <button class="action-btn" @onclick="ViewAllEntries">
                <span class="btn-icon">📚</span>
                View Journal
            </button>
            <button class="action-btn" @onclick="NavigateToCalendar">
                <span class="btn-icon">📅</span>
                Calendar
            </button>
            <button class="action-btn" @onclick="NavigateToAnalytics">
                <span class="btn-icon">📊</span>
                Analytics
            </button>
        </div>

        <!-- Two Column Layout -->
        <div class="content-grid">
            <!-- Left Column -->
            <div class="content-column">
                <!-- Mood Overview -->
                <div class="card">
                    <h3 class="card-title">Mood Overview</h3>
                    @if (moodDistribution != null && moodDistribution.Values.Sum() > 0)
                    {
                        var total = moodDistribution.Values.Sum();
                        @foreach (var mood in moodDistribution.OrderByDescending(m => m.Value))
                        {
                            var percentage = total > 0 ? (int)((mood.Value * 100.0) / total) : 0;
                            var color = mood.Key switch
                            {
                                "Positive" => "#10b981",
                                "Neutral" => "#6b7280",
                                "Negative" => "#ef4444",
                                _ => "#6b7280"
                            };

                            <div class="mood-item">
                                <div class="mood-label">
                                    <span>@mood.Key</span>
                                    <span class="mood-count">@mood.Value (@percentage%)</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill"
                                         style="width: @percentage%; background-color: @color;"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="empty-text">No mood data yet</p>
                    }
                </div>

                <!-- Top Tags -->
                <div class="card">
                    <h3 class="card-title">Top Tags</h3>
                    @if (topTags != null && topTags.Any())
                    {
                        <div class="tags-list">
                            @foreach (var tag in topTags)
                            {
                                <div class="tag-item">
                                    <span class="tag-name">@tag.Key</span>
                                    <span class="tag-count">@tag.Value</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="empty-text">No tags used yet</p>
                    }
                </div>
            </div>

            <!-- Right Column -->
            <div class="content-column">
                <!-- Today's Entry -->
                @if (todayEntry != null)
                {
                    <div class="card">
                        <h3 class="card-title">Today's Entry</h3>
                        <h4 class="entry-title">@todayEntry.Title</h4>

                        @if (!string.IsNullOrWhiteSpace(todayEntry.PrimaryMood))
                        {
                            <div class="mood-badge-container">
                                <span class="mood-badge"
                                      style="background-color: @MoodService.GetMoodColor(todayEntry.PrimaryMood)">
                                    @MoodService.GetMoodEmoji(todayEntry.PrimaryMood) @todayEntry.PrimaryMood
                                </span>
                            </div>
                        }

                        <p class="entry-preview">
                            @{
                                var preview = GetContentPreview(todayEntry.Content, 150);
                            }
                            @preview
                        </p>

                        <button class="btn-link" @onclick="@(() => ViewEntry(todayEntry.Id))">
                            Read more →
                        </button>
                    </div>
                }
                else
                {
                    <div class="card empty-state">
                        <div class="empty-icon">📝</div>
                        <h3>No entry for today</h3>
                        <p>Start your day by creating a journal entry</p>
                        <button class="btn-primary" @onclick="CreateNewEntry">Create Entry</button>
                    </div>
                }

                <!-- Quick Stats -->
                <div class="card">
                    <h3 class="card-title">Writing Stats</h3>
                    <div class="stats-list">
                        <div class="stat-item">
                            <span class="stat-item-label">Average Words</span>
                            <span class="stat-item-value">@averageWords</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-item-label">Days Active</span>
                            <span class="stat-item-value">@daysSinceFirst</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-item-label">This Week</span>
                            <span class="stat-item-value">@weeklyEntries / 7</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-item-label">Most Frequent Mood</span>
                            <span class="stat-item-value">
                                @if (!string.IsNullOrEmpty(mostFrequentMood))
                                {
                                    <span class="mood-emoji-inline">@MoodService.GetMoodEmoji(mostFrequentMood)</span>
                                    <span>@mostFrequentMood</span>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Recent Entries -->
                @if (recentEntries.Any())
                {
                    <div class="card">
                        <h3 class="card-title">Recent Entries</h3>
                        <div class="recent-list">
                            @foreach (var entry in recentEntries.Take(5))
                            {
                                <div class="recent-item" @onclick="@(() => ViewEntry(entry.Id))">
                                    <div class="recent-content">
                                        <div class="recent-title">@entry.Title</div>
                                        <div class="recent-date">@entry.Date.ToString("MMM dd, yyyy")</div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(entry.PrimaryMood))
                                    {
                                        <div class="recent-mood">
                                            @MoodService.GetMoodEmoji(entry.PrimaryMood)
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<JournalEntry> entries = new();
    private List<JournalEntry> recentEntries = new();
    private JournalEntry? todayEntry;
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;

    // Statistics
    private int currentStreak = 0;
    private int longestStreak = 0;
    private int missedDays = 0;
    private int totalEntries = 0;
    private int averageWords = 0;
    private int daysSinceFirst = 0;
    private int weeklyEntries = 0;
    private string? mostFrequentMood;
    private Dictionary<string, int> moodDistribution = new();
    private Dictionary<string, int> topTags = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Good morning";
        if (hour < 17) return "Good afternoon";
        return "Good evening";
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            entries = await JournalService.GetAllEntriesAsync();
            totalEntries = entries.Count;
            todayEntry = await JournalService.GetTodayEntryAsync();
            recentEntries = entries
                .Where(e => e.Date.Date != DateTime.Today)
                .OrderByDescending(e => e.Date)
                .Take(5)
                .ToList();

            if (entries.Any())
            {
                CalculateStatistics();
            }

            Logger.LogInformation("Dashboard loaded successfully with {Count} entries", entries.Count);
        }
        catch (ApplicationException ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load dashboard");
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "An unexpected error occurred while loading the dashboard.";
            Logger.LogError(ex, "Unexpected error loading dashboard");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStatistics()
    {
        try
        {
            CalculateStreaks();
            var totalWords = entries.Sum(e => CountWords(e.Content));
            averageWords = entries.Count > 0 ? totalWords / entries.Count : 0;
            var firstEntry = entries.OrderBy(e => e.Date).FirstOrDefault();
            daysSinceFirst = firstEntry != null ? (DateTime.Today - firstEntry.Date.Date).Days + 1 : 0;
            moodDistribution = GetMoodDistribution();
            mostFrequentMood = GetMostFrequentMood();
            topTags = GetTopTags();

            if (firstEntry != null)
            {
                var totalDays = (DateTime.Today - firstEntry.Date.Date).Days + 1;
                missedDays = totalDays - entries.Count;
            }

            var weekStart = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek);
            weeklyEntries = entries.Count(e => e.Date.Date >= weekStart && e.Date.Date <= DateTime.Today);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error calculating dashboard statistics");
        }
    }

    private void CalculateStreaks()
    {
        var sortedDates = entries.Select(e => e.Date.Date).Distinct().OrderByDescending(d => d).ToList();
        if (!sortedDates.Any()) return;

        currentStreak = 0;
        var checkDate = DateTime.Today;
        foreach (var date in sortedDates)
        {
            if (date == checkDate || date == checkDate.AddDays(-1))
            {
                currentStreak++;
                checkDate = date.AddDays(-1);
            }
            else break;
        }

        longestStreak = 0;
        int tempStreak = 1;
        var allDates = sortedDates.OrderBy(d => d).ToList();
        for (int i = 1; i < allDates.Count; i++)
        {
            if ((allDates[i] - allDates[i - 1]).Days == 1)
            {
                tempStreak++;
            }
            else
            {
                longestStreak = Math.Max(longestStreak, tempStreak);
                tempStreak = 1;
            }
        }
        longestStreak = Math.Max(longestStreak, tempStreak);
    }

    private Dictionary<string, int> GetMoodDistribution()
    {
        var distribution = new Dictionary<string, int>
        {
            { "Positive", 0 },
            { "Neutral", 0 },
            { "Negative", 0 }
        };

        foreach (var entry in entries)
        {
            if (!string.IsNullOrWhiteSpace(entry.MoodCategory) && distribution.ContainsKey(entry.MoodCategory))
            {
                distribution[entry.MoodCategory]++;
            }
        }

        return distribution;
    }

    private string? GetMostFrequentMood()
    {
        if (!entries.Any()) return null;
        var moodCounts = entries
            .Where(e => !string.IsNullOrWhiteSpace(e.PrimaryMood))
            .GroupBy(e => e.PrimaryMood)
            .Select(g => new { Mood = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefault();
        return moodCounts?.Mood;
    }

    private Dictionary<string, int> GetTopTags()
    {
        var tagDict = new Dictionary<string, int>();
        foreach (var entry in entries)
        {
            var tags = TagService.ParseTags(entry.Tags);
            foreach (var tag in tags)
            {
                if (tagDict.ContainsKey(tag))
                    tagDict[tag]++;
                else
                    tagDict[tag] = 1;
            }
        }
        return tagDict.OrderByDescending(kvp => kvp.Value).Take(5).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
    }

    private int CountWords(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return 0;
        var plainText = System.Text.RegularExpressions.Regex.Replace(text, "<.*?>", " ");
        return plainText.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private string GetContentPreview(string htmlContent, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(htmlContent))
            return "No content available...";
        var plainText = System.Text.RegularExpressions.Regex.Replace(htmlContent, "<.*?>", " ");
        plainText = System.Text.RegularExpressions.Regex.Replace(plainText, @"\s+", " ").Trim();
        if (string.IsNullOrWhiteSpace(plainText))
            return "No content available...";
        if (plainText.Length > maxLength)
            return plainText.Substring(0, maxLength) + "...";
        return plainText;
    }

    private void CreateNewEntry() => Navigation.NavigateTo("/newentry");
    private void ViewEntry(int entryId) => Navigation.NavigateTo($"/viewentry/{entryId}?from=home");
    private void ViewAllEntries() => Navigation.NavigateTo("/journal");
    private void NavigateToCalendar() => Navigation.NavigateTo("/calendar");
    private void NavigateToAnalytics() => Navigation.NavigateTo("/analytics");
}