@page "/viewentry/{entryId:int}"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject NavigationManager Navigation

<PageTitle>View Entry</PageTitle>

<div class="entry-container">
    @if (isLoading)
    {
        <div class="loading-container">
            <p>Loading entry...</p>
        </div>
    }
    else if (entry == null)
    {
        <div class="alert alert-error">
            Entry not found!
        </div>
        <div class="button-group">
            <button class="btn btn-secondary" @onclick="BackToJournal">
                ← Back to Journal
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public int EntryId { get; set; }

    private JournalEntry? entry;
    private bool isLoading = true;
    private bool showDeleteModal = false;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntry();
    }

    private async Task LoadEntry()
    {
        isLoading = true;

        var allEntries = await JournalService.GetAllEntriesAsync();
        entry = allEntries.FirstOrDefault(e => e.Id == EntryId);

        isLoading = false;
    }

    private void BackToJournal()
    {
        Navigation.NavigateTo("/journal");
    }

    private void EditEntry()
    {
        if (entry != null)
        {
            Navigation.NavigateTo($"/editentry/{entry.Id}");
        }
    }

    private void ShowDeleteConfirm()
    {
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            showDeleteModal = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (entry == null) return;

        isDeleting = true;

        try
        {
            await JournalService.DeleteEntryAsync(entry.Id);
            Navigation.NavigateTo("/journal");
        }
        catch (Exception)
        {
            // Handle error - could add error message display here
            isDeleting = false;
            showDeleteModal = false;
        }
    }
}