@page "/viewentry/{entryId:int}"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject NavigationManager Navigation

<PageTitle>View Entry</PageTitle>

<div class="entry-container">
    @if (isLoading)
    {
        <div class="loading-container">
            <p>Loading...</p>
        </div>
    }
    else if (entry == null)
    {
        <div class="alert alert-error">
            Entry not found!
        </div>
        <div class="button-group">
            <button class="btn btn-secondary" @onclick="BackToJournal">
                ← Back to Journal
            </button>
        </div>
    }
    else
    {
        <div class="entry-header">
            <h2>@entry.Title</h2>
            <p class="date-display">@entry.Date.ToString("dddd, MMMM dd, yyyy")</p>
        </div>

        <div class="view-content">
            <div class="content-card">
                <!-- Mood Display -->
                @if (!string.IsNullOrWhiteSpace(entry.PrimaryMood))
                {
                    <div class="mood-display-section">
                        <div class="mood-display-label">Mood</div>
                        <div class="mood-display-badges">
                            <div class="mood-display-badge primary" 
                                 style="background-color: @MoodService.GetMoodColor(entry.PrimaryMood)">
                                <span class="mood-emoji">@MoodService.GetMoodEmoji(entry.PrimaryMood)</span>
                                <span class="mood-name">@entry.PrimaryMood</span>
                                <span class="mood-type-label">Primary</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(entry.SecondaryMood1))
                            {
                                <div class="mood-display-badge secondary" 
                                     style="background-color: @MoodService.GetMoodColor(entry.SecondaryMood1)">
                                    <span class="mood-emoji">@MoodService.GetMoodEmoji(entry.SecondaryMood1)</span>
                                    <span class="mood-name">@entry.SecondaryMood1</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(entry.SecondaryMood2))
                            {
                                <div class="mood-display-badge secondary" 
                                     style="background-color: @MoodService.GetMoodColor(entry.SecondaryMood2)">
                                    <span class="mood-emoji">@MoodService.GetMoodEmoji(entry.SecondaryMood2)</span>
                                    <span class="mood-name">@entry.SecondaryMood2</span>
                                </div>
                            }
                        </div>
                        <div class="mood-category-indicator" 
                             style="background-color: @MoodService.GetMoodBackgroundColor(entry.PrimaryMood); 
                                    border-left-color: @MoodService.GetMoodColor(entry.PrimaryMood)">
                            @MoodService.GetCategoryEmoji(entry.MoodCategory) @entry.MoodCategory Mood
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(entry.Tags))
                {
                    <div class="entry-tags-display">
                        @foreach (var tag in TagService.ParseTags(entry.Tags))
                        {
                            <span class="tag-badge" style="background-color: @TagService.GetTagColor(tag)">
                                @tag
                            </span>
                        }
                    </div>
                }

                <div class="content-body">
                    @((MarkupString)entry.Content)
                </div>

                <div class="content-footer">
                    <div class="entry-timestamps">
                        <span>Created: @entry.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</span>
                        @if (entry.UpdatedAt != entry.CreatedAt)
                        {
                            <span>Updated: @entry.UpdatedAt.ToString("MMM dd, yyyy h:mm tt")</span>
                        }
                    </div>
                </div>
            </div>

            <div class="button-group">
                <button class="btn btn-secondary" @onclick="BackToJournal">
                    ← Back to Journal
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int EntryId { get; set; }

    private JournalEntry? entry;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntry();
    }

    private async Task LoadEntry()
    {
        isLoading = true;

        var allEntries = await JournalService.GetAllEntriesAsync();
        entry = allEntries.FirstOrDefault(e => e.Id == EntryId);

        isLoading = false;
    }

    private void BackToJournal()
    {
        Navigation.NavigateTo("/journal");
    }
}
