@page "/analytics"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject ILogger<Analytics> Logger

<PageTitle>Analytics</PageTitle>

<div class="analytics-page">
    <div class="analytics-header">
        <h1 class="analytics-title">Analytics</h1>
        <p class="analytics-subtitle">Insights into your journaling journey</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <p>Loading analytics...</p>
        </div>
    }
    else if (hasError)
    {
        <div class="alert alert-error">
            <p>⚠️ @errorMessage</p>
            <button class="btn btn-secondary" @onclick="LoadAnalytics">Retry</button>
        </div>
    }
    else if (filteredEntries.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">📊</div>
            <h3>No data available</h3>
            <p>Start journaling to see your analytics!</p>
        </div>
    }
    else
    {
        <!-- Date Range Filter -->
        <div class="filter-section">
            <label class="filter-label">Time Period:</label>
            <select class="filter-select" @bind="dateRangeFilter" @bind:after="ApplyDateFilter">
                <option value="all">All Time</option>
                <option value="week">Last 7 Days</option>
                <option value="month">Last 30 Days</option>
                <option value="3months">Last 3 Months</option>
                <option value="year">Last Year</option>
            </select>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">📝</div>
                <div class="stat-value">@filteredEntries.Count</div>
                <div class="stat-label">Total Entries</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">🔥</div>
                <div class="stat-value">@currentStreak</div>
                <div class="stat-label">Current Streak</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">⭐</div>
                <div class="stat-value">@longestStreak</div>
                <div class="stat-label">Longest Streak</div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">@(string.IsNullOrEmpty(mostFrequentMood) ? "😊" : MoodService.GetMoodEmoji(mostFrequentMood))</div>
                <div class="stat-value">@(string.IsNullOrEmpty(mostFrequentMood) ? "-" : mostFrequentMood)</div>
                <div class="stat-label">Top Mood</div>
            </div>
        </div>

        <!-- Two Column Layout -->
        <div class="content-grid">
            <!-- Left Column -->
            <div class="content-column">
                <!-- Mood Distribution -->
                <div class="card">
                    <h3 class="card-title">Mood Distribution</h3>
                    @if (moodDistribution != null && moodDistribution.Values.Sum() > 0)
                    {
                        var total = moodDistribution.Values.Sum();
                        <div class="mood-bars">
                            @foreach (var mood in moodDistribution.OrderByDescending(m => m.Value))
                            {
                                var percentage = total > 0 ? (int)((mood.Value * 100.0) / total) : 0;
                                var color = mood.Key switch
                                {
                                    "Positive" => "#10b981",
                                    "Neutral" => "#6b7280",
                                    "Negative" => "#ef4444",
                                    _ => "#6b7280"
                                };
                                var emoji = mood.Key switch
                                {
                                    "Positive" => "😊",
                                    "Neutral" => "😐",
                                    "Negative" => "😢",
                                    _ => "😐"
                                };

                                <div class="mood-bar-item">
                                    <div class="mood-bar-header">
                                        <span class="mood-label">@emoji @mood.Key</span>
                                        <span class="mood-count">@percentage%</span>
                                    </div>
                                    <div class="mood-bar-track">
                                        <div class="mood-bar-fill" style="width: @percentage%; background-color: @color;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="no-data">No mood data available</p>
                    }
                </div>

                <!-- Writing Trends -->
                <div class="card">
                    <h3 class="card-title">Writing Trends</h3>
                    @if (filteredEntries.Count >= 2)
                    {
                        <div class="trends-container">
                            <div class="trend-stat">
                                <span class="trend-label">Recent Average</span>
                                <span class="trend-value">
                                    @recentAverage words
                                    @if (trendPercentage != 0)
                                    {
                                        <span class="trend-indicator @(trendPercentage > 0 ? "positive" : "negative")">
                                            @(trendPercentage > 0 ? "↗️" : "↘️") @Math.Abs(trendPercentage)%
                                        </span>
                                    }
                                </span>
                            </div>
                            <p class="trend-message">@GetTrendMessage()</p>

                            <!-- Mini Sparkline -->
                            <div class="sparkline-container">
                                <div class="sparkline">
                                    @for (int i = 0; i < Math.Min(recentWordCounts.Count, 10); i++)
                                    {
                                        var height = recentWordCounts.Max() > 0
                                        ? (int)((recentWordCounts[i] * 100.0) / recentWordCounts.Max())
                                        : 50;
                                        <div class="sparkline-bar" style="height: @height%;" title="@recentWordCounts[i] words"></div>
                                    }
                                </div>
                                <div class="sparkline-labels">
                                    <span class="sparkline-label-left">Oldest</span>
                                    <span class="sparkline-label-center">Last @Math.Min(recentWordCounts.Count, 10) entries</span>
                                    <span class="sparkline-label-right">Latest</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="no-data">Need at least 2 entries to show trends</p>
                    }
                </div>
            </div>

            <!-- Right Column -->
            <div class="content-column">
                <!-- Top Tags -->
                <div class="card">
                    <h3 class="card-title">Top Tags</h3>
                    @if (tagCounts.Any())
                    {
                        <div class="tags-list">
                            @foreach (var tag in tagCounts.Take(8))
                            {
                                var percentage = tagCounts.Values.Max() > 0 ? (int)((tag.Value * 100.0) / tagCounts.Values.Max()) : 0;
                                <div class="tag-item">
                                    <div class="tag-header">
                                        <span class="tag-name" style="color: @TagService.GetTagColor(tag.Key)">@tag.Key</span>
                                        <span class="tag-count">@tag.Value</span>
                                    </div>
                                    <div class="tag-bar-track">
                                        <div class="tag-bar-fill" style="width: @percentage%; background-color: @TagService.GetTagColor(tag.Key);"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="no-data">No tags used yet</p>
                    }
                </div>

                <!-- Writing Stats -->
                <div class="card">
                    <h3 class="card-title">Writing Stats</h3>
                    <div class="stats-list">
                        <div class="stat-row">
                            <span class="stat-row-label">Total Words</span>
                            <span class="stat-row-value">@totalWords</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-row-label">Average Words/Entry</span>
                            <span class="stat-row-value">@averageWords</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-row-label">Missed Days</span>
                            <span class="stat-row-value">@missedDaysList.Count</span>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="card">
                    <h3 class="card-title">Recent Activity</h3>
                    @if (missedDaysList.Any())
                    {
                        <div class="activity-info">
                            <p class="activity-text">
                                <span class="activity-icon">⚠️</span>
                                You've missed <strong>@missedDaysList.Count days</strong> since your first entry
                            </p>
                            @if (currentStreak > 0)
                            {
                                <p class="activity-text success">
                                    <span class="activity-icon">🔥</span>
                                    Keep it up! You're on a <strong>@currentStreak day streak</strong>
                                </p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="activity-success">
                            <p>🎉 Perfect! No missed days since your first entry!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<JournalEntry> entries = new();
    private List<JournalEntry> filteredEntries = new();
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private string dateRangeFilter = "all";

    // Statistics
    private int currentStreak = 0;
    private int longestStreak = 0;
    private int totalWords = 0;
    private int averageWords = 0;
    private string? mostFrequentMood;
    private Dictionary<string, int> moodDistribution = new();
    private Dictionary<string, int> tagCounts = new();
    private List<DateTime> missedDaysList = new();

    // Trend statistics
    private int recentAverage = 0;
    private int olderAverage = 0;
    private int trendPercentage = 0;
    private List<int> recentWordCounts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalytics();
    }

    private async Task LoadAnalytics()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            entries = await JournalService.GetAllEntriesAsync();
            ApplyDateFilter();

            Logger.LogInformation("Successfully loaded {Count} entries for analytics", entries.Count);
        }
        catch (ApplicationException ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load analytics");
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "An unexpected error occurred while loading analytics.";
            Logger.LogError(ex, "Unexpected error loading analytics");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyDateFilter()
    {
        DateTime? startDate = dateRangeFilter switch
        {
            "week" => DateTime.Today.AddDays(-7),
            "month" => DateTime.Today.AddDays(-30),
            "3months" => DateTime.Today.AddMonths(-3),
            "year" => DateTime.Today.AddYears(-1),
            _ => null
        };

        filteredEntries = startDate.HasValue
            ? entries.Where(e => e.Date >= startDate.Value).ToList()
            : entries;

        if (filteredEntries.Any())
        {
            CalculateStatistics();
        }
    }

    private void CalculateStatistics()
    {
        try
        {
            // Calculate streaks
            CalculateStreaks();

            // Calculate word counts
            totalWords = filteredEntries.Sum(e => CountWords(e.Content));
            averageWords = filteredEntries.Count > 0 ? totalWords / filteredEntries.Count : 0;

            // Get mood distribution
            moodDistribution = GetMoodDistribution();

            // Get most frequent mood
            mostFrequentMood = GetMostFrequentMood();

            // Calculate tag usage
            tagCounts = CalculateTagCounts();

            // Calculate missed days
            missedDaysList = CalculateMissedDays();

            // Calculate writing trends
            CalculateWritingTrends();

            Logger.LogInformation("Statistics calculated successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error calculating statistics");
        }
    }

    private void CalculateStreaks()
    {
        var sortedDates = filteredEntries.Select(e => e.Date.Date).Distinct().OrderByDescending(d => d).ToList();

        if (!sortedDates.Any()) return;

        // Current streak
        currentStreak = 0;
        var checkDate = DateTime.Today;

        foreach (var date in sortedDates)
        {
            if (date == checkDate || date == checkDate.AddDays(-1))
            {
                currentStreak++;
                checkDate = date.AddDays(-1);
            }
            else
            {
                break;
            }
        }

        // Longest streak
        longestStreak = 0;
        int tempStreak = 1;

        var allDates = sortedDates.OrderBy(d => d).ToList();
        for (int i = 1; i < allDates.Count; i++)
        {
            if ((allDates[i] - allDates[i - 1]).Days == 1)
            {
                tempStreak++;
            }
            else
            {
                longestStreak = Math.Max(longestStreak, tempStreak);
                tempStreak = 1;
            }
        }
        longestStreak = Math.Max(longestStreak, tempStreak);
    }

    private Dictionary<string, int> GetMoodDistribution()
    {
        var distribution = new Dictionary<string, int>
        {
            { "Positive", 0 },
            { "Neutral", 0 },
            { "Negative", 0 }
        };

        foreach (var entry in filteredEntries)
        {
            if (!string.IsNullOrWhiteSpace(entry.MoodCategory) && distribution.ContainsKey(entry.MoodCategory))
            {
                distribution[entry.MoodCategory]++;
            }
        }

        return distribution;
    }

    private string? GetMostFrequentMood()
    {
        if (!filteredEntries.Any()) return null;

        var moodCounts = filteredEntries
            .Where(e => !string.IsNullOrWhiteSpace(e.PrimaryMood))
            .GroupBy(e => e.PrimaryMood)
            .Select(g => new { Mood = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefault();

        return moodCounts?.Mood;
    }

    private Dictionary<string, int> CalculateTagCounts()
    {
        var tagDict = new Dictionary<string, int>();

        foreach (var entry in filteredEntries)
        {
            var tags = TagService.ParseTags(entry.Tags);
            foreach (var tag in tags)
            {
                if (tagDict.ContainsKey(tag))
                    tagDict[tag]++;
                else
                    tagDict[tag] = 1;
            }
        }

        return tagDict.OrderByDescending(kvp => kvp.Value).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
    }

    private List<DateTime> CalculateMissedDays()
    {
        var missedDays = new List<DateTime>();

        if (!filteredEntries.Any()) return missedDays;

        var firstEntry = filteredEntries.Min(e => e.Date.Date);
        var lastDate = DateTime.Today;
        var entryDates = filteredEntries.Select(e => e.Date.Date).ToHashSet();

        for (var date = firstEntry; date < lastDate; date = date.AddDays(1))
        {
            if (!entryDates.Contains(date))
            {
                missedDays.Add(date);
            }
        }

        return missedDays.OrderByDescending(d => d).ToList();
    }

    private int CountWords(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return 0;

        // Strip HTML tags
        var plainText = System.Text.RegularExpressions.Regex.Replace(text, "<.*?>", " ");
        return plainText.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private void CalculateWritingTrends()
    {
        if (filteredEntries.Count < 2)
        {
            recentAverage = averageWords;
            olderAverage = averageWords;
            trendPercentage = 0;
            recentWordCounts = new List<int>();
            return;
        }

        // Get ordered entries by date (most recent first)
        var orderedEntries = filteredEntries.OrderByDescending(e => e.Date).ToList();

        // Get word counts for sparkline (last 10 entries, reversed for oldest→newest display)
        recentWordCounts = orderedEntries
            .Take(10)
            .Select(e => CountWords(e.Content))
            .Reverse()
            .ToList();

        // Split entries into recent (last 30%) and older (first 30%) for comparison
        var splitPoint = Math.Max(2, filteredEntries.Count / 3);
        var recentEntries = orderedEntries.Take(splitPoint).ToList();
        var olderEntries = orderedEntries.Skip(filteredEntries.Count - splitPoint).ToList();

        if (olderEntries.Any())
        {
            recentAverage = recentEntries.Any()
                ? (int)recentEntries.Average(e => CountWords(e.Content))
                : averageWords;

            olderAverage = (int)olderEntries.Average(e => CountWords(e.Content));

            // Calculate percentage change
            if (olderAverage > 0)
            {
                trendPercentage = (int)(((recentAverage - olderAverage) * 100.0) / olderAverage);
            }
        }
        else
        {
            recentAverage = averageWords;
            olderAverage = averageWords;
            trendPercentage = 0;
        }
    }

    private string GetTrendMessage()
    {
        if (trendPercentage > 15)
            return "🚀 You're writing significantly more lately! Keep it up!";
        else if (trendPercentage > 5)
            return "📈 Your entries are getting longer. Great progress!";
        else if (trendPercentage < -15)
            return "📉 Your entries have been shorter recently.";
        else if (trendPercentage < -5)
            return "↘️ You're writing a bit less than before.";
        else
            return "→ Your writing length is steady and consistent.";
    }
}