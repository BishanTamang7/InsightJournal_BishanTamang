@page "/analytics"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject ILogger<Analytics> Logger

<PageTitle>Analytics</PageTitle>

<div class="analytics-page">
    <div class="analytics-header">
        <h1 class="analytics-title">Journal Analytics</h1>
        <p class="analytics-subtitle">Insights into your journaling journey</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <p>Loading analytics...</p>
        </div>
    }
    else if (hasError)
    {
        <div class="alert alert-error">
            <p>⚠️ @errorMessage</p>
            <button class="btn btn-secondary" @onclick="LoadAnalytics">Retry</button>
        </div>
    }
    else if (entries.Count == 0)
    {
        <div class="empty-state">
            <h3>No data available</h3>
            <p>Start journaling to see your analytics!</p>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">📝</div>
                <div class="stat-content">
                    <h3>@entries.Count</h3>
                    <p>Total Entries</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">🔥</div>
                <div class="stat-content">
                    <h3>@currentStreak</h3>
                    <p>Current Streak</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">⭐</div>
                <div class="stat-content">
                    <h3>@longestStreak</h3>
                    <p>Longest Streak</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">📊</div>
                <div class="stat-content">
                    <h3>@totalWords</h3>
                    <p>Total Words</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">✍️</div>
                <div class="stat-content">
                    <h3>@averageWords</h3>
                    <p>Avg Words/Entry</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">📅</div>
                <div class="stat-content">
                    <h3>@daysSinceFirst</h3>
                    <p>Days of Journaling</p>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
            <!-- Entries by Month -->
            <div class="chart-card">
                <h2 class="chart-title">Entries This Year</h2>
                <div class="chart-container">
                    <div class="bar-chart">
                        @foreach (var month in monthlyData)
                        {
                            var maxEntries = monthlyData.Values.Max();
                            var heightPercent = maxEntries > 0 ? (month.Value * 100.0 / maxEntries) : 0;

                            <div class="bar-item">
                                <div class="bar-value">@month.Value</div>
                                <div class="bar" style="height: @(heightPercent)%"></div>
                                <div class="bar-label">@month.Key</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Most Used Tags -->
            <div class="chart-card">
                <h2 class="chart-title">Most Used Tags</h2>
                <div class="tags-chart">
                    @if (tagCounts.Any())
                    {
                        @foreach (var tag in tagCounts.Take(10))
                        {
                            var widthPercent = tagCounts.Values.Max() > 0
                            ? (tag.Value * 100.0 / tagCounts.Values.Max())
                            : 0;

                            <div class="tag-bar-item">
                                <div class="tag-bar-label" style="color: @TagService.GetTagColor(tag.Key)">
                                    @tag.Key
                                </div>
                                <div class="tag-bar-container">
                                    <div class="tag-bar"
                                         style="width: @(widthPercent)%; background-color: @TagService.GetTagColor(tag.Key)">
                                    </div>
                                    <span class="tag-bar-count">@tag.Value</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="no-data">No tags used yet</p>
                    }
                </div>
            </div>
        </div>

        <!-- Activity Heatmap -->
        <div class="chart-card">
            <h2 class="chart-title">Writing Activity (Last 12 Weeks)</h2>
            <div class="heatmap-container">
                <div class="heatmap-grid">
                    @foreach (var week in heatmapData)
                    {
                        <div class="heatmap-column">
                            @foreach (var day in week)
                            {
                                var intensity = GetHeatmapIntensity(day.Count);
                                <div class="heatmap-cell @intensity"
                                     title="@day.Date.ToString("MMM dd"): @day.Count entries">
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="heatmap-legend">
                    <span>Less</span>
                    <div class="legend-cell intensity-0"></div>
                    <div class="legend-cell intensity-1"></div>
                    <div class="legend-cell intensity-2"></div>
                    <div class="legend-cell intensity-3"></div>
                    <div class="legend-cell intensity-4"></div>
                    <span>More</span>
                </div>
            </div>
        </div>

        <!-- Recent Milestones -->
        <div class="chart-card">
            <h2 class="chart-title">Milestones</h2>
            <div class="milestones-list">
                @if (entries.Count >= 1)
                {
                    <div class="milestone-item">
                        <div class="milestone-icon">🎉</div>
                        <div class="milestone-content">
                            <h4>First Entry</h4>
                            <p>@entries.OrderBy(e => e.Date).First().Date.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>
                }

                @if (entries.Count >= 10)
                {
                    <div class="milestone-item">
                        <div class="milestone-icon">🏆</div>
                        <div class="milestone-content">
                            <h4>10 Entries Milestone</h4>
                            <p>You're building a great habit!</p>
                        </div>
                    </div>
                }

                @if (entries.Count >= 50)
                {
                    <div class="milestone-item">
                        <div class="milestone-icon">⭐</div>
                        <div class="milestone-content">
                            <h4>50 Entries Milestone</h4>
                            <p>Impressive dedication!</p>
                        </div>
                    </div>
                }

                @if (longestStreak >= 7)
                {
                    <div class="milestone-item">
                        <div class="milestone-icon">🔥</div>
                        <div class="milestone-content">
                            <h4>7-Day Streak</h4>
                            <p>You've journaled for a week straight!</p>
                        </div>
                    </div>
                }

                @if (longestStreak >= 30)
                {
                    <div class="milestone-item">
                        <div class="milestone-icon">💎</div>
                        <div class="milestone-content">
                            <h4>30-Day Streak</h4>
                            <p>A month of consistent journaling!</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<JournalEntry> entries = new();
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;

    // Statistics
    private int currentStreak = 0;
    private int longestStreak = 0;
    private int totalWords = 0;
    private int averageWords = 0;
    private int daysSinceFirst = 0;
    private Dictionary<string, int> monthlyData = new();
    private Dictionary<string, int> tagCounts = new();
    private List<List<DayData>> heatmapData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalytics();
    }

    private async Task LoadAnalytics()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            entries = await JournalService.GetAllEntriesAsync();
            Logger.LogInformation("Successfully loaded {Count} entries for analytics", entries.Count);

            if (entries.Any())
            {
                CalculateStatistics();
            }
        }
        catch (ApplicationException ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load analytics");
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "An unexpected error occurred while loading analytics.";
            Logger.LogError(ex, "Unexpected error loading analytics");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStatistics()
    {
        try
        {
            // Calculate streaks
            CalculateStreaks();

            // Calculate word counts
            totalWords = entries.Sum(e => CountWords(e.Content));
            averageWords = entries.Count > 0 ? totalWords / entries.Count : 0;

            // Calculate days since first entry
            var firstEntry = entries.OrderBy(e => e.Date).FirstOrDefault();
            daysSinceFirst = firstEntry != null ? (DateTime.Today - firstEntry.Date.Date).Days + 1 : 0;

            // Calculate monthly data
            monthlyData = CalculateMonthlyData();

            // Calculate tag usage
            tagCounts = CalculateTagCounts();

            // Generate heatmap data
            heatmapData = GenerateHeatmapData();

            Logger.LogInformation("Statistics calculated successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error calculating statistics");
        }
    }

    private void CalculateStreaks()
    {
        var sortedDates = entries.Select(e => e.Date.Date).Distinct().OrderByDescending(d => d).ToList();

        if (!sortedDates.Any()) return;

        // Current streak
        currentStreak = 0;
        var checkDate = DateTime.Today;

        foreach (var date in sortedDates)
        {
            if (date == checkDate || date == checkDate.AddDays(-1))
            {
                currentStreak++;
                checkDate = date.AddDays(-1);
            }
            else
            {
                break;
            }
        }

        // Longest streak
        longestStreak = 0;
        int tempStreak = 1;

        var allDates = sortedDates.OrderBy(d => d).ToList();
        for (int i = 1; i < allDates.Count; i++)
        {
            if ((allDates[i] - allDates[i - 1]).Days == 1)
            {
                tempStreak++;
            }
            else
            {
                longestStreak = Math.Max(longestStreak, tempStreak);
                tempStreak = 1;
            }
        }
        longestStreak = Math.Max(longestStreak, tempStreak);
    }

    private Dictionary<string, int> CalculateMonthlyData()
    {
        var currentYear = DateTime.Today.Year;
        var result = new Dictionary<string, int>();

        for (int i = 1; i <= 12; i++)
        {
            var monthName = new DateTime(currentYear, i, 1).ToString("MMM");
            var count = entries.Count(e => e.Date.Year == currentYear && e.Date.Month == i);
            result[monthName] = count;
        }

        return result;
    }

    private Dictionary<string, int> CalculateTagCounts()
    {
        var tagDict = new Dictionary<string, int>();

        foreach (var entry in entries)
        {
            var tags = TagService.ParseTags(entry.Tags);
            foreach (var tag in tags)
            {
                if (tagDict.ContainsKey(tag))
                    tagDict[tag]++;
                else
                    tagDict[tag] = 1;
            }
        }

        return tagDict.OrderByDescending(kvp => kvp.Value).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
    }

    private List<List<DayData>> GenerateHeatmapData()
    {
        var result = new List<List<DayData>>();
        var startDate = DateTime.Today.AddDays(-84); // 12 weeks

        for (int week = 0; week < 12; week++)
        {
            var weekData = new List<DayData>();
            for (int day = 0; day < 7; day++)
            {
                var date = startDate.AddDays(week * 7 + day);
                var count = entries.Count(e => e.Date.Date == date);
                weekData.Add(new DayData { Date = date, Count = count });
            }
            result.Add(weekData);
        }

        return result;
    }

    private string GetHeatmapIntensity(int count)
    {
        return count switch
        {
            0 => "intensity-0",
            1 => "intensity-1",
            2 => "intensity-2",
            3 => "intensity-3",
            _ => "intensity-4"
        };
    }

    private int CountWords(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return 0;

        return text.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private class DayData
    {
        public DateTime Date { get; set; }
        public int Count { get; set; }
    }
}