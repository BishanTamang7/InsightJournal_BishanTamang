@page "/analytics"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject ILogger<Analytics> Logger

<PageTitle>Analytics</PageTitle>

<div class="analytics-page">
    <div class="analytics-header">
        <h1 class="analytics-title">Journal Analytics</h1>
        <p class="analytics-subtitle">Insights into your journaling journey</p>
    </div>

    <!-- Date Range Filter -->
    <div class="date-filter-section">
        <label class="filter-label">Date Range:</label>
        <select class="filter-dropdown" @bind="dateRangeFilter" @bind:after="ApplyDateFilter">
            <option value="all">All Time</option>
            <option value="week">Last 7 Days</option>
            <option value="month">Last 30 Days</option>
            <option value="3months">Last 3 Months</option>
            <option value="year">Last Year</option>
        </select>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <p>Loading analytics...</p>
        </div>
    }
    else if (hasError)
    {
        <div class="alert alert-error">
            <p>⚠️ @errorMessage</p>
            <button class="btn btn-secondary" @onclick="LoadAnalytics">Retry</button>
        </div>
    }
    else if (filteredEntries.Count == 0)
    {
        <div class="empty-state">
            <h3>No data available</h3>
            <p>Start journaling to see your analytics!</p>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">📝</div>
                <div class="stat-content">
                    <h3>@filteredEntries.Count</h3>
                    <p>Total Entries</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">🔥</div>
                <div class="stat-content">
                    <h3>@currentStreak</h3>
                    <p>Current Streak</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">⭐</div>
                <div class="stat-content">
                    <h3>@longestStreak</h3>
                    <p>Longest Streak</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">😊</div>
                <div class="stat-content">
                    <h3>@(string.IsNullOrEmpty(mostFrequentMood) ? "-" : MoodService.GetMoodEmoji(mostFrequentMood))</h3>
                    <p>Most Frequent Mood</p>
                    @if (!string.IsNullOrEmpty(mostFrequentMood))
                    {
                        <span class="stat-detail">@mostFrequentMood</span>
                    }
                </div>
            </div>
        </div>

        <!-- Mood Distribution -->
        <div class="chart-card">
            <h2 class="chart-title">Mood Distribution</h2>
            <div class="mood-distribution-chart">
                @if (moodDistribution != null && moodDistribution.Values.Sum() > 0)
                {
                    var total = moodDistribution.Values.Sum();
                    <div class="mood-bars">
                        @foreach (var mood in moodDistribution.OrderByDescending(m => m.Value))
                        {
                            var percentage = total > 0 ? (int)((mood.Value * 100.0) / total) : 0;
                            var color = mood.Key switch
                            {
                                "Positive" => "#10b981",
                                "Neutral" => "#6b7280",
                                "Negative" => "#ef4444",
                                _ => "#6b7280"
                            };
                            var emoji = mood.Key switch
                            {
                                "Positive" => "😊",
                                "Neutral" => "😐",
                                "Negative" => "😢",
                                _ => "😐"
                            };

                            <div class="mood-bar-item">
                                <div class="mood-bar-header">
                                    <span class="mood-bar-label">@emoji @mood.Key</span>
                                    <span class="mood-bar-count">@mood.Value entries (@percentage%)</span>
                                </div>
                                <div class="mood-bar-track">
                                    <div class="mood-bar-fill" style="width: @percentage%; background-color: @color;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-data">No mood data available</p>
                }
            </div>
        </div>

        <!-- Most Used Tags -->
        <div class="chart-card">
            <h2 class="chart-title">Most Used Tags</h2>
            <div class="tags-chart">
                @if (tagCounts.Any())
                {
                    var totalTagUsage = tagCounts.Values.Sum();
                    @foreach (var tag in tagCounts.Take(10))
                    {
                        var widthPercent = tagCounts.Values.Max() > 0
                        ? (tag.Value * 100.0 / tagCounts.Values.Max())
                        : 0;
                        var percentage = totalTagUsage > 0 ? (int)((tag.Value * 100.0) / totalTagUsage) : 0;

                        <div class="tag-bar-item">
                            <div class="tag-bar-label" style="color: @TagService.GetTagColor(tag.Key)">
                                @tag.Key
                            </div>
                            <div class="tag-bar-container">
                                <div class="tag-bar"
                                     style="width: @(widthPercent)%; background-color: @TagService.GetTagColor(tag.Key)">
                                </div>
                                <span class="tag-bar-count">@tag.Value (@percentage%)</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="no-data">No tags used yet</p>
                }
            </div>
        </div>

        <!-- Word Count Trends -->
        <div class="chart-card">
            <h2 class="chart-title">Word Count Trends Over Time</h2>
            <div class="word-trends-chart">
                @if (wordTrendData.Any())
                {
                    var maxWords = wordTrendData.Max(w => w.Words);
                    <div class="line-chart">
                        <div class="chart-y-axis">
                            <span>@maxWords</span>
                            <span>@(maxWords / 2)</span>
                            <span>0</span>
                        </div>
                        <div class="chart-area">
                            <svg viewBox="0 0 1000 300" preserveAspectRatio="none">
                                <!-- Grid lines -->
                                <line x1="0" y1="75" x2="1000" y2="75" stroke="var(--border-color)" stroke-width="1" opacity="0.3" />
                                <line x1="0" y1="150" x2="1000" y2="150" stroke="var(--border-color)" stroke-width="1" opacity="0.3" />
                                <line x1="0" y1="225" x2="1000" y2="225" stroke="var(--border-color)" stroke-width="1" opacity="0.3" />

                                <!-- Line path -->
                                <polyline points="@GetLineChartPoints()"
                                          fill="none"
                                          stroke="#5b5fc7"
                                          stroke-width="3"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />

                                <!-- Data points -->
                                @for (int i = 0; i < wordTrendData.Count; i++)
                                {
                                    var x = (i * 1000.0 / (wordTrendData.Count - 1));
                                    var y = maxWords > 0 ? (300 - (wordTrendData[i].Words * 300.0 / maxWords)) : 150;
                                    <circle cx="@x" cy="@y" r="5" fill="#5b5fc7" />
                                }
                            </svg>
                        </div>
                        <div class="chart-x-axis">
                            @foreach (var point in wordTrendData.Where((_, i) => i % Math.Max(1, wordTrendData.Count / 8) == 0))
                            {
                                <span>@point.Date.ToString("MMM dd")</span>
                            }
                        </div>
                    </div>
                    <div class="chart-stats">
                        <span>Average: @averageWords words/entry</span>
                        <span>Total: @totalWords words</span>
                    </div>
                }
                else
                {
                    <p class="no-data">No word count data available</p>
                }
            </div>
        </div>

        <!-- Missed Days List -->
        <div class="chart-card">
            <h2 class="chart-title">Missed Days (@missedDaysList.Count days)</h2>
            <div class="missed-days-section">
                @if (missedDaysList.Any())
                {
                    <div class="missed-days-list">
                        @foreach (var date in missedDaysList.Take(20))
                        {
                            <div class="missed-day-item">
                                <span class="missed-icon">⚠️</span>
                                <span class="missed-date">@date.ToString("dddd, MMMM dd, yyyy")</span>
                            </div>
                        }
                        @if (missedDaysList.Count > 20)
                        {
                            <div class="missed-day-item more-items">
                                <span>... and @(missedDaysList.Count - 20) more days</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-missed-days">
                        <p>🎉 No missed days! You've been consistent since your first entry!</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<JournalEntry> entries = new();
    private List<JournalEntry> filteredEntries = new();
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private string dateRangeFilter = "all";

    // Statistics
    private int currentStreak = 0;
    private int longestStreak = 0;
    private int totalWords = 0;
    private int averageWords = 0;
    private string? mostFrequentMood;
    private Dictionary<string, int> moodDistribution = new();
    private Dictionary<string, int> tagCounts = new();
    private List<WordTrendPoint> wordTrendData = new();
    private List<DateTime> missedDaysList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalytics();
    }

    private async Task LoadAnalytics()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            entries = await JournalService.GetAllEntriesAsync();
            ApplyDateFilter();

            Logger.LogInformation("Successfully loaded {Count} entries for analytics", entries.Count);
        }
        catch (ApplicationException ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load analytics");
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "An unexpected error occurred while loading analytics.";
            Logger.LogError(ex, "Unexpected error loading analytics");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyDateFilter()
    {
        DateTime? startDate = dateRangeFilter switch
        {
            "week" => DateTime.Today.AddDays(-7),
            "month" => DateTime.Today.AddDays(-30),
            "3months" => DateTime.Today.AddMonths(-3),
            "year" => DateTime.Today.AddYears(-1),
            _ => null
        };

        filteredEntries = startDate.HasValue
            ? entries.Where(e => e.Date >= startDate.Value).ToList()
            : entries;

        if (filteredEntries.Any())
        {
            CalculateStatistics();
        }
    }

    private void CalculateStatistics()
    {
        try
        {
            // Calculate streaks
            CalculateStreaks();

            // Calculate word counts
            totalWords = filteredEntries.Sum(e => CountWords(e.Content));
            averageWords = filteredEntries.Count > 0 ? totalWords / filteredEntries.Count : 0;

            // Get mood distribution
            moodDistribution = GetMoodDistribution();

            // Get most frequent mood
            mostFrequentMood = GetMostFrequentMood();

            // Calculate tag usage
            tagCounts = CalculateTagCounts();

            // Calculate word trends
            wordTrendData = CalculateWordTrends();

            // Calculate missed days
            missedDaysList = CalculateMissedDays();

            Logger.LogInformation("Statistics calculated successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error calculating statistics");
        }
    }

    private void CalculateStreaks()
    {
        var sortedDates = filteredEntries.Select(e => e.Date.Date).Distinct().OrderByDescending(d => d).ToList();

        if (!sortedDates.Any()) return;

        // Current streak
        currentStreak = 0;
        var checkDate = DateTime.Today;

        foreach (var date in sortedDates)
        {
            if (date == checkDate || date == checkDate.AddDays(-1))
            {
                currentStreak++;
                checkDate = date.AddDays(-1);
            }
            else
            {
                break;
            }
        }

        // Longest streak
        longestStreak = 0;
        int tempStreak = 1;

        var allDates = sortedDates.OrderBy(d => d).ToList();
        for (int i = 1; i < allDates.Count; i++)
        {
            if ((allDates[i] - allDates[i - 1]).Days == 1)
            {
                tempStreak++;
            }
            else
            {
                longestStreak = Math.Max(longestStreak, tempStreak);
                tempStreak = 1;
            }
        }
        longestStreak = Math.Max(longestStreak, tempStreak);
    }

    private Dictionary<string, int> GetMoodDistribution()
    {
        var distribution = new Dictionary<string, int>
        {
            { "Positive", 0 },
            { "Neutral", 0 },
            { "Negative", 0 }
        };

        foreach (var entry in filteredEntries)
        {
            if (!string.IsNullOrWhiteSpace(entry.MoodCategory) && distribution.ContainsKey(entry.MoodCategory))
            {
                distribution[entry.MoodCategory]++;
            }
        }

        return distribution;
    }

    private string? GetMostFrequentMood()
    {
        if (!filteredEntries.Any()) return null;

        var moodCounts = filteredEntries
            .Where(e => !string.IsNullOrWhiteSpace(e.PrimaryMood))
            .GroupBy(e => e.PrimaryMood)
            .Select(g => new { Mood = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .FirstOrDefault();

        return moodCounts?.Mood;
    }

    private Dictionary<string, int> CalculateTagCounts()
    {
        var tagDict = new Dictionary<string, int>();

        foreach (var entry in filteredEntries)
        {
            var tags = TagService.ParseTags(entry.Tags);
            foreach (var tag in tags)
            {
                if (tagDict.ContainsKey(tag))
                    tagDict[tag]++;
                else
                    tagDict[tag] = 1;
            }
        }

        return tagDict.OrderByDescending(kvp => kvp.Value).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
    }

    private List<WordTrendPoint> CalculateWordTrends()
    {
        return filteredEntries
            .OrderBy(e => e.Date)
            .Select(e => new WordTrendPoint
            {
                Date = e.Date,
                Words = CountWords(e.Content)
            })
            .ToList();
    }

    private List<DateTime> CalculateMissedDays()
    {
        var missedDays = new List<DateTime>();

        if (!filteredEntries.Any()) return missedDays;

        var firstEntry = filteredEntries.Min(e => e.Date.Date);
        var lastDate = DateTime.Today;
        var entryDates = filteredEntries.Select(e => e.Date.Date).ToHashSet();

        for (var date = firstEntry; date < lastDate; date = date.AddDays(1))
        {
            if (!entryDates.Contains(date))
            {
                missedDays.Add(date);
            }
        }

        return missedDays.OrderByDescending(d => d).ToList();
    }

    private string GetLineChartPoints()
    {
        if (!wordTrendData.Any()) return "";

        var maxWords = wordTrendData.Max(w => w.Words);
        var points = new List<string>();

        for (int i = 0; i < wordTrendData.Count; i++)
        {
            var x = i * 1000.0 / (wordTrendData.Count - 1);
            var y = maxWords > 0 ? (300 - (wordTrendData[i].Words * 300.0 / maxWords)) : 150;
            points.Add($"{x},{y}");
        }

        return string.Join(" ", points);
    }

    private int CountWords(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return 0;

        // Strip HTML tags
        var plainText = System.Text.RegularExpressions.Regex.Replace(text, "<.*?>", " ");
        return plainText.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private class WordTrendPoint
    {
        public DateTime Date { get; set; }
        public int Words { get; set; }
    }
}