@page "/settings"
@inject ThemeService ThemeService
@inject JournalService JournalService
@inject PdfExportService PdfExportService
@inject PasswordService PasswordService
@inject ILogger<Settings> Logger

<div class="settings-page">
    <div class="settings-content">
        <h1 class="settings-title">Settings</h1>

        <!-- Security & Privacy -->
        <section class="settings-section">
            <h2 class="section-title">Security & Privacy</h2>

            <div class="setting-item">
                <div class="setting-label">Enable Password</div>
                <label class="toggle-switch">
                    <input type="checkbox"
                           @bind="passwordProtectionEnabled"
                           @bind:after="OnPasswordToggleChanged" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            @if (passwordProtectionEnabled && PasswordService.HasPassword())
            {
                <div class="setting-item">
                    <div class="setting-label">Change Password</div>
                    <button class="action-btn" @onclick="ShowChangePasswordModal">Change</button>
                </div>
            }
        </section>

        <!-- Data Management -->
        <section class="settings-section">
            <h2 class="section-title">Data Management</h2>

            <div class="setting-item date-range-item">
                <div class="setting-label">Date Range for Export</div>
                <div class="date-range-inputs">
                    <input type="date" class="date-input" @bind="exportStartDate" />
                    <span class="date-separator">to</span>
                    <input type="date" class="date-input" @bind="exportEndDate" />
                </div>
            </div>

            <div class="setting-item">
                <div class="setting-label">Export Journal Data (PDF)</div>
                <button class="action-btn"
                        @onclick="ShowExportConfirmation"
                        disabled="@isExporting">
                    @if (isExporting)
                    {
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <span>Export PDF</span>
                    }
                </button>
            </div>
        </section>

        <!-- Theme Customization -->
        <section class="settings-section">
            <h2 class="section-title">Theme Customization</h2>

            <div class="setting-item">
                <div class="setting-label">Light and Dark Mode</div>
                <label class="toggle-switch">
                    <input type="checkbox"
                           @bind="isDarkMode"
                           @bind:after="OnDarkModeChanged" />
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </section>
    </div>
</div>

<!-- Toast Notification -->
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-notification @(toastSuccess ? "success" : "error")">
        <div class="toast-content">
            @if (toastSuccess)
            {
                <span class="toast-icon">✓</span>
            }
            else
            {
                <span class="toast-icon">✕</span>
            }
            <span>@toastMessage</span>
        </div>
    </div>
}

<!-- Set Password Modal (First Time) -->
@if (showSetPasswordModal)
{
    <div class="modal-overlay" @onclick="CancelSetPassword">
        <div class="modal-content password-modal" @onclick:stopPropagation>
            <h3>Set Password</h3>
            <p>Create a password to protect your journal</p>

            @if (!string.IsNullOrEmpty(passwordError))
            {
                <div class="password-error">
                    ⚠️ @passwordError
                </div>
            }

            <form @onsubmit="ConfirmSetPassword" class="password-form-modal">
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password"
                           class="form-input"
                           @bind="newPassword"
                           placeholder="Enter new password"
                           minlength="4"
                           required />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password"
                           class="form-input"
                           @bind="confirmPassword"
                           placeholder="Confirm new password"
                           minlength="4"
                           required />
                </div>

                <div class="password-requirements">
                    <p>Password must be at least 4 characters long</p>
                </div>

                <div class="modal-buttons">
                    <button type="submit" class="btn btn-primary">
                        Set Password
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelSetPassword">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Change Password Modal -->
@if (showChangePasswordModal)
{
    <div class="modal-overlay" @onclick="CancelChangePassword">
        <div class="modal-content password-modal" @onclick:stopPropagation>
            <h3>Change Password</h3>
            <p>Enter your current password and choose a new one</p>

            @if (!string.IsNullOrEmpty(passwordError))
            {
                <div class="password-error">
                    ⚠️ @passwordError
                </div>
            }

            <form @onsubmit="ConfirmChangePassword" class="password-form-modal">
                <div class="form-group">
                    <label>Current Password</label>
                    <input type="password"
                           class="form-input"
                           @bind="currentPassword"
                           placeholder="Enter current password"
                           required />
                </div>

                <div class="form-group">
                    <label>New Password</label>
                    <input type="password"
                           class="form-input"
                           @bind="newPassword"
                           placeholder="Enter new password"
                           minlength="4"
                           required />
                </div>

                <div class="form-group">
                    <label>Confirm New Password</label>
                    <input type="password"
                           class="form-input"
                           @bind="confirmPassword"
                           placeholder="Confirm new password"
                           minlength="4"
                           required />
                </div>

                <div class="modal-buttons">
                    <button type="submit" class="btn btn-primary">
                        Change Password
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelChangePassword">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Export Confirmation Modal -->
@if (showExportModal)
{
    <div class="modal-overlay" @onclick="CancelExport">
        <div class="modal-content" @onclick:stopPropagation>
            <h3>Export Journal to PDF</h3>
            <p>You are about to export your journal entries from:</p>
            <div style="background-color: var(--bg-tertiary); padding: 15px; border-radius: 8px; margin: 15px 0;">
                <p style="margin: 5px 0; font-weight: 600; color: var(--text-primary);">
                    <strong>Start Date:</strong> @exportStartDate.ToString("MMMM dd, yyyy")
                </p>
                <p style="margin: 5px 0; font-weight: 600; color: var(--text-primary);">
                    <strong>End Date:</strong> @exportEndDate.ToString("MMMM dd, yyyy")
                </p>
                <p style="margin: 5px 0; font-size: 0.9rem; color: var(--text-secondary);">
                    Duration: @((exportEndDate - exportStartDate).Days + 1) days
                </p>
            </div>
            <p style="color: var(--text-secondary); font-size: 0.9rem;">
                The PDF will be saved to your Downloads folder.
            </p>
            <div class="modal-buttons">
                <button class="btn btn-primary" @onclick="ConfirmExport">
                    Confirm Export
                </button>
                <button class="btn btn-secondary" @onclick="CancelExport">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool passwordProtectionEnabled = false;
    private bool isDarkMode = false;
    private DateTime exportStartDate = DateTime.Today.AddMonths(-1);
    private DateTime exportEndDate = DateTime.Today;

    // Export related
    private bool isExporting = false;
    private bool showExportModal = false;
    private string? toastMessage;
    private bool toastSuccess = false;

    // Password related
    private bool showSetPasswordModal = false;
    private bool showChangePasswordModal = false;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string? passwordError;

    protected override void OnInitialized()
    {
        isDarkMode = ThemeService.CurrentTheme == "dark";
        passwordProtectionEnabled = PasswordService.IsPasswordEnabled();
    }

    private void OnDarkModeChanged()
    {
        ThemeService.SetTheme(isDarkMode ? "dark" : "light");
    }

    // Password Toggle Changed
    private async Task OnPasswordToggleChanged()
    {
        try
        {
            if (passwordProtectionEnabled)
            {
                // Enabling password protection
                if (!PasswordService.HasPassword())
                {
                    // No password set yet, show set password modal
                    showSetPasswordModal = true;
                }
                else
                {
                    // Password already exists, just enable it
                    PasswordService.SetPasswordEnabled(true);
                    ShowToast("Password protection enabled", true);
                }
            }
            else
            {
                // Disabling password protection
                PasswordService.SetPasswordEnabled(false);
                ShowToast("Password protection disabled", true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling password protection");
            passwordProtectionEnabled = !passwordProtectionEnabled; // Revert toggle
            ShowToast("Failed to change password protection", false);
        }
    }

    // Set Password (First Time)
    private void ConfirmSetPassword()
    {
        passwordError = null;

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            passwordError = "Password cannot be empty";
            return;
        }

        if (newPassword.Length < 4)
        {
            passwordError = "Password must be at least 4 characters long";
            return;
        }

        if (newPassword != confirmPassword)
        {
            passwordError = "Passwords do not match";
            return;
        }

        try
        {
            if (PasswordService.SetPassword(newPassword))
            {
                PasswordService.SetPasswordEnabled(true);
                showSetPasswordModal = false;
                ClearPasswordFields();
                ShowToast("Password set successfully", true);
                Logger.LogInformation("Password protection enabled");
            }
            else
            {
                passwordError = "Failed to set password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error setting password");
            passwordError = "An error occurred while setting the password";
        }
    }

    private void CancelSetPassword()
    {
        showSetPasswordModal = false;
        passwordProtectionEnabled = false; // Revert toggle
        ClearPasswordFields();
    }

    // Change Password
    private void ShowChangePasswordModal()
    {
        showChangePasswordModal = true;
        passwordError = null;
        ClearPasswordFields();
    }

    private void ConfirmChangePassword()
    {
        passwordError = null;

        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            passwordError = "Please enter your current password";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            passwordError = "New password cannot be empty";
            return;
        }

        if (newPassword.Length < 4)
        {
            passwordError = "Password must be at least 4 characters long";
            return;
        }

        if (newPassword != confirmPassword)
        {
            passwordError = "New passwords do not match";
            return;
        }

        try
        {
            if (PasswordService.ChangePassword(currentPassword, newPassword))
            {
                showChangePasswordModal = false;
                ClearPasswordFields();
                ShowToast("Password changed successfully", true);
                Logger.LogInformation("Password changed successfully");
            }
            else
            {
                passwordError = "Current password is incorrect";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing password");
            passwordError = "An error occurred while changing the password";
        }
    }

    private void CancelChangePassword()
    {
        showChangePasswordModal = false;
        ClearPasswordFields();
    }

    // Helper Methods
    private void ClearPasswordFields()
    {
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
        passwordError = null;
    }

    private async void ShowToast(string message, bool success)
    {
        toastMessage = message;
        toastSuccess = success;
        StateHasChanged();

        await Task.Delay(3000);
        toastMessage = null;
        StateHasChanged();
    }

    // Export Methods
    private void ShowExportConfirmation()
    {
        toastMessage = null;
        toastSuccess = false;

        if (exportEndDate < exportStartDate)
        {
            ShowToast("End date must be after start date", false);
            return;
        }

        showExportModal = true;
    }

    private void CancelExport()
    {
        showExportModal = false;
    }

    private async Task ConfirmExport()
    {
        showExportModal = false;
        await ExportToPdf();
    }

    private async Task ExportToPdf()
    {
        isExporting = true;
        toastMessage = null;
        toastSuccess = false;
        StateHasChanged();

        try
        {
            if (exportEndDate < exportStartDate)
            {
                isExporting = false;
                ShowToast("End date must be after start date", false);
                return;
            }

            var allEntries = await JournalService.GetAllEntriesAsync();
            var filteredEntries = allEntries
                .Where(e => e.Date.Date >= exportStartDate.Date && e.Date.Date <= exportEndDate.Date)
                .ToList();

            if (filteredEntries.Count == 0)
            {
                isExporting = false;
                ShowToast($"No entries found between {exportStartDate:MMM dd, yyyy} and {exportEndDate:MMM dd, yyyy}", false);
                return;
            }

            await PdfExportService.ExportEntriesToPdfAsync(
                filteredEntries,
                exportStartDate,
                exportEndDate,
                "InsightJournal User"
            );

            isExporting = false;
            ShowToast("PDF exported successfully to Downloads folder", true);
        }
        catch (Exception ex)
        {
            isExporting = false;
            ShowToast($"Error exporting PDF: {ex.Message}", false);
            Logger.LogError(ex, "PDF Export Error");
        }
    }
}