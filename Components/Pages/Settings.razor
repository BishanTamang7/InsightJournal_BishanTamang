@page "/settings"
@inject ThemeService ThemeService

<div class="settings-page">
    <div class="settings-content">
        <h1 class="settings-title">Settings</h1>

        <!-- Security & Privacy -->
        <section class="settings-section">
            <h2 class="section-title">Security & Privacy</h2>

            <div class="setting-item">
                <div class="setting-label">Enable Password/PIN Protection</div>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="passwordProtectionEnabled" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-label">Change Password/PIN</div>
                <button class="action-btn" @onclick="ChangePassword">Change</button>
            </div>
        </section>

        <!-- Data Management -->
        <section class="settings-section">
            <h2 class="section-title">Data Management</h2>

            <div class="setting-item">
                <div class="setting-label">Export Journal Data (PDF)</div>
                <button class="action-btn" @onclick="ExportToPdf">Export</button>
            </div>

            <div class="setting-item date-range-item">
                <div class="setting-label">Date Range for Export</div>
                <div class="date-range-inputs">
                    <input type="date" class="date-input" @bind="exportStartDate" />
                    <span class="date-separator">to</span>
                    <input type="date" class="date-input" @bind="exportEndDate" />
                </div>
            </div>
        </section>

        <!-- Theme Customization -->
        <section class="settings-section">
            <h2 class="section-title">Theme Customization</h2>

            <div class="setting-item">
                <div class="setting-label">Dark Mode</div>
                <label class="toggle-switch">
                    <input type="checkbox"
                           @bind="isDarkMode"
                           @bind:after="OnDarkModeChanged" />
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </section>
    </div>
</div>

@code {
    private bool passwordProtectionEnabled = false;
    private bool isDarkMode = false;
    private DateTime exportStartDate = DateTime.Today.AddMonths(-1);
    private DateTime exportEndDate = DateTime.Today;

    protected override void OnInitialized()
    {
        isDarkMode = ThemeService.CurrentTheme == "dark";
    }

    private void OnDarkModeChanged()
    {
        ThemeService.SetTheme(isDarkMode ? "dark" : "light");
    }

    private void ChangePassword()
    {
        // TODO: Implement password change functionality
        Console.WriteLine("Change password clicked");
    }

    private void ExportToPdf()
    {
        // TODO: Implement PDF export functionality
        Console.WriteLine($"Export PDF from {exportStartDate:MM/dd/yyyy} to {exportEndDate:MM/dd/yyyy}");
    }
}