@page "/newentry"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject NavigationManager Navigation

<PageTitle>New Entry</PageTitle>

<div class="entry-container">
    <div class="entry-header">
        <h2>New Entry</h2>
        <p class="date-display">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">
            ⚠️ @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            ✓ @successMessage
        </div>
    }

    <div class="entry-form">
        <div class="form-group">
            <label>Title <span style="color: #ef4444;">*</span></label>
            <input type="text"
                   class="form-input"
                   @bind="title"
                   placeholder="Give your entry a title... (Required)"
                   required />
        </div>

        <!-- Mood Selection -->
        <div class="form-group">
            <label>Primary Mood <span style="color: #ef4444;">*</span></label>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px;">
                How are you feeling today? (Required)
            </p>
            <div class="mood-categories">
                @foreach (var category in MoodService.MoodsByCategory)
                {
                    <div class="mood-category-section">
                        <div class="mood-category-header" style="color: @MoodService.GetCategoryColor(category.Key)">
                            @MoodService.GetCategoryEmoji(category.Key) @category.Key
                        </div>
                        <div class="mood-options">
                            @foreach (var mood in category.Value)
                            {
                                <label class="mood-option @(primaryMood == mood ? "selected" : "")"
                                       style="--mood-color: @MoodService.GetMoodColor(mood);">
                                    <input type="radio"
                                           name="primaryMood"
                                           value="@mood"
                                           checked="@(primaryMood == mood)"
                                           @onchange="@(() => SelectPrimaryMood(mood))" />
                                    <span class="mood-label">
                                        <span class="mood-emoji">@MoodService.GetMoodEmoji(mood)</span>
                                        <span class="mood-name">@mood</span>
                                    </span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Secondary Moods -->
        <div class="form-group">
            <label>Secondary Moods (Optional)</label>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px;">
                Select up to 2 additional moods you're experiencing
            </p>

            <!-- Secondary Mood 1 -->
            <div class="secondary-mood-container">
                <select class="form-select" @bind="secondaryMood1" disabled="@string.IsNullOrEmpty(primaryMood)">
                    <option value="">Select secondary mood 1...</option>
                    @foreach (var mood in GetAvailableSecondaryMoods())
                    {
                        <option value="@mood">@MoodService.GetMoodEmoji(mood) @mood</option>
                    }
                </select>
            </div>

            <!-- Secondary Mood 2 -->
            @if (!string.IsNullOrWhiteSpace(secondaryMood1))
            {
                <div class="secondary-mood-container" style="margin-top: 8px;">
                    <select class="form-select" @bind="secondaryMood2">
                        <option value="">Select secondary mood 2...</option>
                        @foreach (var mood in GetAvailableSecondaryMoods())
                        {
                            <option value="@mood">@MoodService.GetMoodEmoji(mood) @mood</option>
                        }
                    </select>
                </div>
            }

            <!-- Selected Moods Display -->
            @if (!string.IsNullOrEmpty(primaryMood) || !string.IsNullOrEmpty(secondaryMood1) || !string.IsNullOrEmpty(secondaryMood2))
            {
                <div class="selected-moods-display">
                    @if (!string.IsNullOrEmpty(primaryMood))
                    {
                        <div class="mood-badge primary" style="background-color: @MoodService.GetMoodColor(primaryMood)">
                            @MoodService.GetMoodEmoji(primaryMood) @primaryMood (Primary)
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(secondaryMood1))
                    {
                        <div class="mood-badge secondary" style="background-color: @MoodService.GetMoodColor(secondaryMood1)">
                            @MoodService.GetMoodEmoji(secondaryMood1) @secondaryMood1
                            <button type="button" class="remove-mood" @onclick="() => RemoveSecondaryMood(1)">×</button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(secondaryMood2))
                    {
                        <div class="mood-badge secondary" style="background-color: @MoodService.GetMoodColor(secondaryMood2)">
                            @MoodService.GetMoodEmoji(secondaryMood2) @secondaryMood2
                            <button type="button" class="remove-mood" @onclick="() => RemoveSecondaryMood(2)">×</button>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Manual Category Selector -->
        <div class="form-group">
            <label>Category <span style="color: #ef4444;">*</span></label>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px;">
                Select the emotional category (Required)
            </p>
            <div class="category-selector">
                <label class="category-option @(selectedCategory == "Positive" ? "selected" : "")"
                       style="--category-color: #10b981;">
                    <input type="radio"
                           name="category"
                           value="Positive"
                           checked="@(selectedCategory == "Positive")"
                           @onchange="@(() => selectedCategory = "Positive")" />
                    <span class="category-content">
                        <span class="category-emoji">😊</span>
                        <span class="category-name">Positive</span>
                    </span>
                </label>

                <label class="category-option @(selectedCategory == "Neutral" ? "selected" : "")"
                       style="--category-color: #6b7280;">
                    <input type="radio"
                           name="category"
                           value="Neutral"
                           checked="@(selectedCategory == "Neutral")"
                           @onchange="@(() => selectedCategory = "Neutral")" />
                    <span class="category-content">
                        <span class="category-emoji">😐</span>
                        <span class="category-name">Neutral</span>
                    </span>
                </label>

                <label class="category-option @(selectedCategory == "Negative" ? "selected" : "")"
                       style="--category-color: #ef4444;">
                    <input type="radio"
                           name="category"
                           value="Negative"
                           checked="@(selectedCategory == "Negative")"
                           @onchange="@(() => selectedCategory = "Negative")" />
                    <span class="category-content">
                        <span class="category-emoji">😢</span>
                        <span class="category-name">Negative</span>
                    </span>
                </label>
            </div>
        </div>

        <!-- Tags Section -->
        <div class="form-group">
            <label>Tags <span style="color: #ef4444;">*</span></label>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px;">
                Select at least one predefined tag or add a custom one (Required)
            </p>

            <!-- Predefined Tags -->
            <div class="tags-container">
                @foreach (var tag in TagService.PredefinedTags)
                {
                    <label class="tag-checkbox" style="--tag-color: @TagService.GetTagColor(tag)">
                        <input type="checkbox"
                               checked="@selectedTags.Contains(tag)"
                               @onchange="@((e) => ToggleTag(tag, (bool)e.Value!))" />
                        <span class="tag-label">@tag</span>
                    </label>
                }
            </div>

            <!-- Custom Tag Input -->
            <div class="custom-tag-section">
                <label class="custom-tag-label">Add Custom Tag</label>
                <div class="custom-tag-input-row">
                    <input type="text"
                           class="form-input"
                           @bind="customTagInput"
                           @onkeydown="@HandleCustomTagKeyPress"
                           placeholder="Type custom tag and press Enter"
                           maxlength="30" />
                    <button type="button" class="btn-add-tag" @onclick="AddCustomTag">
                        + Add
                    </button>
                </div>

                @if (customTags.Any())
                {
                    <div class="custom-tags-list">
                        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 8px;">
                            Custom Tags:
                        </p>
                        <div class="tags-container">
                            @foreach (var tag in customTags)
                            {
                                <div class="custom-tag-badge">
                                    <span>@tag</span>
                                    <button type="button" class="remove-tag" @onclick="() => RemoveCustomTag(tag)">×</button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Rich Text Editor -->
        <div class="form-group">
            <label>Content <span style="color: #ef4444;">*</span></label>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px;">
                Write your journal entry (Required)
            </p>
            <QuillEditor @ref="quillEditor"
                         EditorId="newEntryEditor"
                         Content="@content"
                         ContentChanged="@OnContentChanged" />
        </div>

        <!-- Action Buttons -->
        <div class="button-group">
            <button class="btn btn-primary" @onclick="CreateEntry">
                💾 Save Entry
            </button>
        </div>
    </div>
</div>

@code {
    private string title = "";
    private string content = "";
    private List<string> selectedTags = new();
    private List<string> customTags = new();
    private string customTagInput = "";
    private string? errorMessage;
    private string? successMessage;

    // Mood tracking
    private string primaryMood = "";
    private string? secondaryMood1 = null;
    private string? secondaryMood2 = null;
    private string selectedCategory = ""; // Manual category selection

    // Check if entry exists (for validation only)
    private JournalEntry? existingEntry = null;

    // Quill editor reference
    private QuillEditor? quillEditor;

    protected override async Task OnInitializedAsync()
    {
        // Check if today's entry already exists (for validation only)
        existingEntry = await JournalService.GetTodayEntryAsync();

        // Don't pre-fill the form - always show blank
        // The restriction will be enforced when saving
    }

    private void OnContentChanged(string html)
    {
        content = html;
    }

    private void SelectPrimaryMood(string mood)
    {
        primaryMood = mood;
        if (secondaryMood1 == mood) secondaryMood1 = null;
        if (secondaryMood2 == mood) secondaryMood2 = null;
    }

    private List<string> GetAvailableSecondaryMoods()
    {
        return MoodService.GetAvailableSecondaryMoods(primaryMood, secondaryMood1);
    }

    private void RemoveSecondaryMood(int moodNumber)
    {
        if (moodNumber == 1)
        {
            secondaryMood1 = null;
            if (!string.IsNullOrWhiteSpace(secondaryMood2))
            {
                secondaryMood1 = secondaryMood2;
                secondaryMood2 = null;
            }
        }
        else if (moodNumber == 2)
        {
            secondaryMood2 = null;
        }
    }

    private void ToggleTag(string tag, bool isChecked)
    {
        if (isChecked)
        {
            if (!selectedTags.Contains(tag))
            {
                selectedTags.Add(tag);
            }
        }
        else
        {
            selectedTags.Remove(tag);
        }
    }

    private async Task HandleCustomTagKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Task.Run(() => AddCustomTag());
        }
    }

    private void AddCustomTag()
    {
        if (string.IsNullOrWhiteSpace(customTagInput)) return;

        var trimmedTag = customTagInput.Trim();

        // Check if it's not a predefined tag and not already in custom tags
        if (!TagService.PredefinedTags.Contains(trimmedTag) &&
            !customTags.Contains(trimmedTag) &&
            !selectedTags.Contains(trimmedTag))
        {
            customTags.Add(trimmedTag);
            customTagInput = "";
        }
        else
        {
            errorMessage = "Tag already exists or is a predefined tag.";
            Task.Run(async () =>
            {
                await Task.Delay(2000);
                await InvokeAsync(() =>
                {
                    errorMessage = null;
                    StateHasChanged();
                });
            });
        }
    }

    private void RemoveCustomTag(string tag)
    {
        customTags.Remove(tag);
    }

    private async Task CreateEntry()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(title))
        {
            errorMessage = "Please enter a title for your entry.";
            return;
        }

        if (string.IsNullOrWhiteSpace(content))
        {
            errorMessage = "Please write some content for your entry.";
            return;
        }

        if (string.IsNullOrWhiteSpace(primaryMood))
        {
            errorMessage = "Please select your primary mood.";
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedCategory))
        {
            errorMessage = "Please select a category.";
            return;
        }

        // Validate tags - at least one tag required
        var allTags = selectedTags.Concat(customTags).ToList();
        if (!allTags.Any())
        {
            errorMessage = "Please select or add at least one tag.";
            return;
        }

        try
        {
            // Pass manual category to service
            await JournalService.CreateEntryAsync(
                title,
                content,
                allTags,
                primaryMood,
                secondaryMood1,
                secondaryMood2,
                selectedCategory
            );

            successMessage = "Entry created successfully!";

            await Task.Delay(1000);
            Navigation.NavigateTo("/");
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}