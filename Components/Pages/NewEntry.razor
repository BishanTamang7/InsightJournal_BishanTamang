@page "/newentry"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject NavigationManager Navigation

<PageTitle>New Entry</PageTitle>

<div class="entry-container">
    <div class="entry-header">
        <h2>New Entry</h2>
        <p class="date-display">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-error">
            ⚠️ @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            ✓ @successMessage
        </div>
    }

    <div class="entry-form">
        <div class="form-group">
            <label>Title</label>
            <input type="text"
                   class="form-input"
                   @bind="title"
                   placeholder="Give your entry a title..." />
        </div>

        <div class="form-group">
            <label>Tags</label>
            <div class="tags-container">
                @foreach (var tag in TagService.PredefinedTags)
                {
                    <label class="tag-checkbox" style="--tag-color: @TagService.GetTagColor(tag)">
                        <input type="checkbox"
                               checked="@selectedTags.Contains(tag)"
                               @onchange="@((e) => ToggleTag(tag, (bool)e.Value!))" />
                        <span class="tag-label">@tag</span>
                    </label>
                }
            </div>
        </div>

        <div class="form-group">
            <label>Content</label>
            <textarea class="form-textarea"
                      rows="15"
                      @bind="content"
                      placeholder="Write your thoughts here..."></textarea>
        </div>

        <div class="button-group">
            <button class="btn btn-primary" @onclick="CreateEntry">
                💾 Save Entry
            </button>
        </div>
    </div>
</div>

<style>
    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 8px;
    }

    .tag-checkbox {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }

        .tag-checkbox input[type="checkbox"] {
            display: none;
        }

    .tag-label {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        border: 2px solid var(--tag-color);
        color: var(--tag-color);
        background-color: transparent;
        transition: all 0.2s;
    }

    .tag-checkbox input[type="checkbox"]:checked + .tag-label {
        background-color: var(--tag-color);
        color: white;
    }

    .tag-checkbox:hover .tag-label {
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
</style>

@code {
    private string title = "";
    private string content = "";
    private List<string> selectedTags = new();
    private string? errorMessage;
    private string? successMessage;

    private void ToggleTag(string tag, bool isChecked)
    {
        if (isChecked)
        {
            if (!selectedTags.Contains(tag))
            {
                selectedTags.Add(tag);
            }
        }
        else
        {
            selectedTags.Remove(tag);
        }
    }

    private async Task CreateEntry()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(title))
        {
            errorMessage = "Please enter a title for your entry.";
            return;
        }

        if (string.IsNullOrWhiteSpace(content))
        {
            errorMessage = "Please write some content for your entry.";
            return;
        }

        try
        {
            await JournalService.CreateEntryAsync(title, content, selectedTags);
            successMessage = "Entry created successfully!";

            await Task.Delay(1000);
            Navigation.NavigateTo("/journal");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}