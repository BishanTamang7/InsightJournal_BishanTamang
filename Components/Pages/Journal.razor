@page "/journal"
@using InsightJournal.Models
@using InsightJournal.Services
@inject JournalService JournalService
@inject NavigationManager Navigation
@inject ILogger<Journal> Logger

<PageTitle>Journal</PageTitle>

<div class="journal-page">
    <div class="journal-header-new">
        <h1 class="journal-title">Journal Entries</h1>

        <div class="journal-controls">
            <input type="text"
                   class="search-input"
                   placeholder="Search entries by title..."
                   @bind="searchText"
                   @bind:event="oninput"
                   @bind:after="FilterEntries" />

            <select class="filter-dropdown" @bind="dateFilter" @bind:after="FilterEntries">
                <option value="all">All Time</option>
                <option value="today">Today</option>
                <option value="week">Last 7 days</option>
                <option value="month">Last 30 days</option>
                <option value="3months">Last 3 months</option>
                <option value="year">Last Year</option>
            </select>

            <select class="filter-dropdown" @bind="tagFilter" @bind:after="FilterEntries">
                <option value="">All Tags</option>
                @foreach (var tag in TagService.PredefinedTags)
                {
                    <option value="@tag">@tag</option>
                }
            </select>

            <select class="filter-dropdown mood-filter" @bind="moodFilter" @bind:after="FilterEntries">
                <option value="">All Moods</option>
                <option value="" disabled>──────────</option>
                <option value="Positive">😊 Positive</option>
                <option value="Neutral">😐 Neutral</option>
                <option value="Negative">😢 Negative</option>
                <option value="" disabled>──────────</option>
                @foreach (var mood in MoodService.AllMoods)
                {
                    <option value="@mood">@MoodService.GetMoodEmoji(mood) @mood</option>
                }
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <p>Loading entries...</p>
        </div>
    }
    else if (hasError)
    {
        <div class="alert alert-error">
            <p>⚠️ @errorMessage</p>
            <button class="btn btn-secondary" @onclick="RetryLoadEntries">Retry</button>
        </div>
    }
    else if (filteredEntries.Count == 0)
    {
        <div class="empty-state-new">
            <h3>No entries found</h3>
            <p>
                @(string.IsNullOrWhiteSpace(searchText) || !string.IsNullOrWhiteSpace(tagFilter) || !string.IsNullOrWhiteSpace(moodFilter) || dateFilter != "all"
                            ? "Try adjusting your filters or search terms."
                            : "Start your journaling journey by creating your first entry!")
            </p>
            <button class="btn-new-entry" @onclick="GoToNewEntry">
                Create @(filteredEntries.Count == 0 && entries.Count == 0 ? "First" : "New") Entry
            </button>
        </div>
    }
    else
    {
        <div class="entries-list">
            @foreach (var entry in GetPagedEntries())
            {
                <div class="entry-card" @onclick="() => ViewEntry(entry)">
                    <div class="entry-card-content">
                        <h3 class="entry-card-title">@entry.Title</h3>
                        <div class="entry-card-meta">
                            <span class="meta-item">
                                <span class="meta-label">Date:</span> @entry.Date.ToString("yyyy-MM-dd")
                            </span>
                            
                            @if (!string.IsNullOrWhiteSpace(entry.PrimaryMood))
                            {
                                <span class="meta-separator">|</span>
                                <span class="meta-item">
                                    <span class="meta-label">Mood:</span> 
                                    <span class="meta-mood" style="color: @MoodService.GetMoodColor(entry.PrimaryMood)">
                                        @entry.MoodCategory
                                    </span>
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(entry.Tags))
                            {
                                <span class="meta-separator">|</span>
                                <span class="meta-item">
                                    <span class="meta-label">Tags:</span> 
                                    <span class="meta-tags">
                                        @foreach (var tag in TagService.ParseTags(entry.Tags).Take(3))
                                        {
                                            <text>@tag</text>
                                            @if (tag != TagService.ParseTags(entry.Tags).Take(3).Last())
                                            {
                                                <text>, </text>
                                            }
                                        }
                                        @if (TagService.ParseTags(entry.Tags).Count > 3)
                                        {
                                            <text>...</text>
                                        }
                                    </span>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="entry-card-actions">
                        <button class="entry-card-btn btn-view" @onclick:stopPropagation @onclick="() => ViewEntry(entry)">
                            View
                        </button>
                        <button class="entry-card-btn btn-edit" @onclick:stopPropagation @onclick="() => EditEntry(entry)">
                            Edit
                        </button>
                        <button class="entry-card-btn btn-delete" @onclick:stopPropagation @onclick="() => ShowDeleteConfirm(entry)">
                            Delete
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="pagination">
                <button class="pagination-btn"
                        @onclick="PreviousPage"
                        disabled="@(currentPage == 1)">
                    Previous
                </button>

                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNum = i;
                    <button class="pagination-btn @(currentPage == pageNum ? "active" : "")"
                            @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }

                <button class="pagination-btn"
                        @onclick="NextPage"
                        disabled="@(currentPage == totalPages)">
                    Next
                </button>
            </div>
        }
    }

    @if (showDeleteModal)
    {
        <div class="modal-overlay" @onclick="CancelDelete">
            <div class="modal-content" @onclick:stopPropagation>
                <h3>Delete Entry</h3>
                <p>Are you sure you want to delete "<strong>@entryToDelete?.Title</strong>"?</p>
                <p class="warning-text">This action cannot be undone.</p>
                <div class="modal-buttons">
                    <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @(isDeleting ? "Deleting..." : "Yes, Delete")
                    </button>
                    <button class="btn btn-secondary" @onclick="CancelDelete" disabled="@isDeleting">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<JournalEntry> entries = new();
    private List<JournalEntry> filteredEntries = new();
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = string.Empty;
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private JournalEntry? entryToDelete;
    private string searchText = "";
    private string dateFilter = "all";
    private string tagFilter = "";
    private string moodFilter = "";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling(filteredEntries.Count / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        isLoading = true;
        hasError = false;
        errorMessage = string.Empty;

        try
        {
            DateTime? startDate = GetStartDateFromFilter();

            entries = await JournalService.GetAllEntriesAsync(
                searchText: string.IsNullOrWhiteSpace(searchText) ? null : searchText,
                startDate: startDate,
                tag: string.IsNullOrWhiteSpace(tagFilter) ? null : tagFilter
            );

            filteredEntries = ApplyMoodFilter(entries);
            
            Logger.LogInformation("Successfully loaded {Count} entries", entries.Count);
        }
        catch (ApplicationException ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load journal entries");
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "An unexpected error occurred. Please try again.";
            Logger.LogError(ex, "Unexpected error loading journal entries");
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<JournalEntry> ApplyMoodFilter(List<JournalEntry> entriesToFilter)
    {
        if (string.IsNullOrWhiteSpace(moodFilter))
        {
            return entriesToFilter;
        }

        if (moodFilter == "Positive" || moodFilter == "Neutral" || moodFilter == "Negative")
        {
            return entriesToFilter
                .Where(e => e.MoodCategory == moodFilter)
                .ToList();
        }

        return entriesToFilter
            .Where(e => e.PrimaryMood == moodFilter || 
                       e.SecondaryMood1 == moodFilter || 
                       e.SecondaryMood2 == moodFilter)
            .ToList();
    }

    private DateTime? GetStartDateFromFilter()
    {
        var now = DateTime.Today;
        return dateFilter switch
        {
            "today" => now,
            "week" => now.AddDays(-7),
            "month" => now.AddDays(-30),
            "3months" => now.AddMonths(-3),
            "year" => now.AddYears(-1),
            _ => null
        };
    }

    private async Task FilterEntries()
    {
        currentPage = 1;
        await LoadEntries();
    }

    private async Task RetryLoadEntries()
    {
        await LoadEntries();
    }

    private List<JournalEntry> GetPagedEntries()
    {
        return filteredEntries
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void GoToNewEntry()
    {
        Navigation.NavigateTo("/newentry");
    }

    private void ViewEntry(JournalEntry entry)
    {
        Navigation.NavigateTo($"/viewentry/{entry.Id}");
    }

    private void EditEntry(JournalEntry entry)
    {
        Navigation.NavigateTo($"/editentry/{entry.Id}");
    }

    private void ShowDeleteConfirm(JournalEntry entry)
    {
        entryToDelete = entry;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            showDeleteModal = false;
            entryToDelete = null;
        }
    }

    private async Task ConfirmDelete()
    {
        if (entryToDelete == null) return;

        isDeleting = true;

        try
        {
            await JournalService.DeleteEntryAsync(entryToDelete.Id);
            Logger.LogInformation("Successfully deleted entry {EntryId}", entryToDelete.Id);

            showDeleteModal = false;
            entryToDelete = null;
            await LoadEntries();
        }
        catch (KeyNotFoundException ex)
        {
            errorMessage = "Entry not found. It may have already been deleted.";
            hasError = true;
            Logger.LogWarning(ex, "Attempted to delete non-existent entry");
        }
        catch (ApplicationException ex)
        {
            errorMessage = ex.Message;
            hasError = true;
            Logger.LogError(ex, "Error deleting entry");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to delete entry. Please try again.";
            hasError = true;
            Logger.LogError(ex, "Unexpected error deleting entry");
        }
        finally
        {
            isDeleting = false;
            showDeleteModal = false;
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
        }
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }
}
