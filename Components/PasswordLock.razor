@inject PasswordService PasswordService
@inject ILogger<PasswordLock> Logger

@if (IsLocked)
{
    <div class="password-lock-overlay">
        <div class="password-lock-container">
            <div class="lock-icon">🔒</div>
            <h2>Enter Password</h2>
            <p>Please enter your password to access InsightJournal</p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">
                    ⚠️ @errorMessage
                </div>
            }

            <form @onsubmit="VerifyPassword" class="password-form">
                <input type="password"
                       class="password-input"
                       placeholder="Enter password"
                       @bind="passwordInput"
                       autocomplete="off" />
                <button type="submit" class="submit-btn" disabled="@isVerifying">
                    @if (isVerifying)
                    {
                        <span>Verifying...</span>
                    }
                    else
                    {
                        <span>Unlock</span>
                    }
                </button>
            </form>

            <div class="attempts-info">
                @if (failedAttempts > 0)
                {
                    <p>Failed attempts: @failedAttempts</p>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public EventCallback OnUnlocked { get; set; }

    private bool IsLocked { get; set; } = true;
    private string passwordInput = "";
    private string? errorMessage;
    private int failedAttempts = 0;
    private bool isVerifying = false;

    protected override void OnInitialized()
    {
        // Check if password protection is enabled
        IsLocked = PasswordService.IsPasswordEnabled() && PasswordService.HasPassword();
    }

    private async Task VerifyPassword()
    {
        if (string.IsNullOrWhiteSpace(passwordInput))
        {
            errorMessage = "Please enter a password";
            return;
        }

        isVerifying = true;
        errorMessage = null;
        StateHasChanged();

        // Small delay to show verification state
        await Task.Delay(300);

        try
        {
            if (PasswordService.VerifyPassword(passwordInput))
            {
                Logger.LogInformation("Password verified successfully");
                IsLocked = false;
                failedAttempts = 0;
                await OnUnlocked.InvokeAsync();
            }
            else
            {
                failedAttempts++;
                Logger.LogWarning("Failed password attempt #{Attempt}", failedAttempts);
                errorMessage = "Incorrect password. Please try again.";
                passwordInput = "";

                if (failedAttempts >= 5)
                {
                    errorMessage = "Too many failed attempts. Please try again in a moment.";
                    await Task.Delay(3000);
                    failedAttempts = 0;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error verifying password");
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isVerifying = false;
            StateHasChanged();
        }
    }
}